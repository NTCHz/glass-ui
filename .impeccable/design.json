      "css": ".ds-badge{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:9999px;font:500 12px/1 var(--font-sans,system-ui)}.ds-badge-success{background:color-mix(in oklch,var(--success) 15%,transparent);color:var(--success-text)}.ds-badge-warning{background:color-mix(in oklch,var(--warning) 20%,transparent);color:var(--warning-text)}.ds-badge-danger{background:color-mix(in oklch,var(--destructive) 12%,transparent);color:var(--destructive)}.ds-badge-info{background:var(--accent);color:var(--accent-foreground)}"
