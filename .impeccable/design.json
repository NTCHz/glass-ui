      "css": ".ds-card{display:grid;gap:4px;width:280px;padding:20px;border-radius:21.6px;background:var(--card);color:var(--card-foreground);box-shadow:0 0 0 1px var(--border);font-family:var(--font-sans,system-ui)}.ds-card-title{font:600 15px/1.375 var(--font-heading,system-ui);letter-spacing:-.01em}.ds-card-desc{font-size:13px;color:var(--muted-foreground)}"
    },
    {
      "name": "Glass Sidebar",
      "kind": "nav",
      "refersTo": "nav-sidebar",
      "description": "Floating regular-glass slab with capsule-cornered rows.",
      "html": "<div class=\"ds-stage\"><nav class=\"ds-sidebar\"><a class=\"ds-nav-item\" href=\"#\">Button</a><a class=\"ds-nav-item\" href=\"#\">Badge</a><a class=\"ds-nav-item\" href=\"#\">Table</a></nav></div>",
      "css": ".ds-stage{padding:24px;border-radius:28px;background:radial-gradient(60% 80% at 10% 0%,var(--glass-field-1),transparent 70%),radial-gradient(50% 70% at 100% 100%,var(--glass-field-2),transparent 70%),var(--background)}.ds-sidebar{display:grid;gap:2px;width:240px;padding:12px;border-radius:28px;background-color:var(--glass-regular);background-image:radial-gradient(120% 90% at 0% 0%,var(--glass-sheen) 0%,transparent 55%);backdrop-filter:blur(var(--glass-blur)) saturate(var(--glass-saturate)) brightness(var(--glass-brightness));-webkit-backdrop-filter:blur(var(--glass-blur)) saturate(var(--glass-saturate)) brightness(var(--glass-brightness));box-shadow:inset 1px 1px 0 0 var(--glass-rim-hi),inset -1px -1px 0 0 var(--glass-rim-lo),inset 0 0 0 .5px var(--glass-edge),inset 0 0 14px 0 var(--glass-glow),var(--glass-shadow)}.ds-nav-item{display:flex;align-items:center;height:36px;padding:0 12px;border-radius:16.8px;color:color-mix(in oklch,var(--foreground) 80%,transparent);font:500 14px/1 var(--font-sans,system-ui);text-decoration:none;transition:background-color 150ms,color 150ms}.ds-nav-item:hover{background:var(--secondary);color:var(--foreground)}.ds-nav-item:focus-visible{outline:none;box-shadow:0 0 0 3px var(--ring)}"
    },
    {
      "name": "Glass Menu",
      "kind": "custom",
      "refersTo": "menu",
      "description": "Thick-glass menu with solid blue highlighted row.",
      "html": "<div class=\"ds-menu\" role=\"menu\"><div class=\"ds-menu-item\" role=\"menuitem\" tabindex=\"0\">Rename</div><div class=\"ds-menu-item\" role=\"menuitem\" tabindex=\"0\">Duplicate</div><div class=\"ds-menu-item\" role=\"menuitem\" tabindex=\"0\">Archive</div></div>",
      "css": ".ds-menu{width:200px;padding:6px;border-radius:21.6px;color:var(--popover-foreground);background-color:var(--glass-thick);background-image:radial-gradient(120% 90% at 0% 0%,var(--glass-sheen) 0%,transparent 55%);backdrop-filter:blur(calc(var(--glass-blur)*2)) saturate(var(--glass-saturate)) brightness(var(--glass-brightness));-webkit-backdrop-filter:blur(calc(var(--glass-blur)*2)) saturate(var(--glass-saturate)) brightness(var(--glass-brightness));box-shadow:inset 1px 1px 0 0 var(--glass-rim-hi),inset -1px -1px 0 0 var(--glass-rim-lo),inset 0 0 0 .5px var(--glass-edge),inset 0 0 14px 0 var(--glass-glow),var(--glass-shadow);font:400 14px/1.43 var(--font-sans,system-ui)}.ds-menu-item{padding:6px 10px;border-radius:12px;outline:none;cursor:default}.ds-menu-item:hover,.ds-menu-item:focus-visible{background:var(--primary);color:var(--primary-foreground)}"
    },
    {
