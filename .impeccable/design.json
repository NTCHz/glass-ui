      "html": "<button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Wi-Fi\"><span class=\"ds-switch-knob\"></span></button>",
      "css": ".ds-switch{display:inline-flex;align-items:center;width:48px;height:28px;padding:2px;border:0;border-radius:9999px;background:var(--success);cursor:pointer}.ds-switch-knob{width:24px;height:24px;border-radius:9999px;background:#fff;box-shadow:0 2px 6px rgb(0 0 0/.18),0 0 0 .5px rgb(0 0 0/.04);transform:translateX(20px);transition:transform 400ms var(--ease-spring),width 400ms var(--ease-spring)}.ds-switch:active .ds-switch-knob{width:28px;transform:translateX(16px)}.ds-switch:focus-visible{outline:none;box-shadow:0 0 0 3px var(--ring)}"
