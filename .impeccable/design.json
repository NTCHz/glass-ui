  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled System Blue capsule with rim and liquid press.",
      "html": "<button class=\"ds-btn-primary\">Save</button>",
      "css": ".ds-btn-primary{height:36px;padding:0 16px;border:1px solid transparent;border-radius:9999px;background:var(--primary);color:var(--primary-foreground);font:500 14px/1 var(--font-sans,system-ui);box-shadow:inset 1px 1px 0 0 rgb(255 255 255/.4),inset -1px -1px 0 0 rgb(255 255 255/.12),0 6px 16px -6px var(--primary);transition:transform 380ms var(--ease-spring),filter 380ms var(--ease-spring);cursor:pointer}.ds-btn-primary:hover{transform:scale(1.02);filter:brightness(1.06) saturate(1.1)}.ds-btn-primary:active{transform:scale(1.05);filter:brightness(1.12) saturate(1.15);transition-duration:140ms}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px var(--ring)}"
    },
    {
      "name": "Glass Button",
      "kind": "button",
      "refersTo": "button-glass",
      "description": "Regular glass capsule for actions on chrome or media.",
      "html": "<div class=\"ds-stage\"><button class=\"ds-btn-glass\">Glass</button></div>",
      "css": ".ds-stage{padding:24px;border-radius:28px;background:radial-gradient(60% 80% at 10% 0%,var(--glass-field-1),transparent 70%),radial-gradient(50% 70% at 100% 100%,var(--glass-field-3),transparent 70%),var(--background)}.ds-btn-glass{height:36px;padding:0 16px;border:0;border-radius:9999px;color:var(--foreground);font:500 14px/1 var(--font-sans,system-ui);background-color:var(--glass-regular);background-image:radial-gradient(120% 90% at 0% 0%,var(--glass-sheen) 0%,transparent 55%);backdrop-filter:blur(var(--glass-blur)) saturate(var(--glass-saturate)) brightness(var(--glass-brightness));-webkit-backdrop-filter:blur(var(--glass-blur)) saturate(var(--glass-saturate)) brightness(var(--glass-brightness));box-shadow:inset 1px 1px 0 0 var(--glass-rim-hi),inset -1px -1px 0 0 var(--glass-rim-lo),inset 0 0 0 .5px var(--glass-edge),inset 0 0 14px 0 var(--glass-glow),var(--glass-shadow);transition:transform 380ms var(--ease-spring),filter 380ms var(--ease-spring);cursor:pointer}.ds-btn-glass:hover{transform:scale(1.02);filter:brightness(1.06) saturate(1.1)}.ds-btn-glass:active{transform:scale(1.05);transition-duration:140ms}.ds-btn-glass:focus-visible{outline:none;box-shadow:0 0 0 3px var(--ring),var(--glass-shadow)}"
    },
    {
