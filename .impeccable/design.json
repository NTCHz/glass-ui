      "css": ".ds-btn-secondary{height:36px;padding:0 16px;border:1px solid transparent;border-radius:9999px;background:var(--secondary);color:var(--secondary-foreground);font:500 14px/1 var(--font-sans,system-ui);transition:background-color 150ms,transform 150ms;cursor:pointer}.ds-btn-secondary:hover{background:color-mix(in oklch,var(--secondary),var(--foreground) 6%)}.ds-btn-secondary:active{transform:scale(.97)}.ds-btn-secondary:focus-visible{outline:none;box-shadow:0 0 0 3px var(--ring)}"
    },
