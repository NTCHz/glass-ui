          "chart-3": "oklch(0.7 0.16 300)",
          "chart-4": "oklch(0.8 0.14 65)",
          "chart-5": "oklch(0.72 0.17 350)",
          "glass-solid": "oklch(0.23 0.012 260)",
          "glass-clear": "oklch(0.22 0.012 260 / 0.2)",
          "glass-regular": "oklch(0.24 0.012 260 / 0.5)",
          "glass-thick": "oklch(0.24 0.012 260 / 0.74)",
          "glass-sheen": "oklch(1 0 0 / 0.07)",
          "glass-rim-hi": "oklch(1 0 0 / 0.3)",
          "glass-rim-lo": "oklch(1 0 0 / 0.1)",
          "glass-edge": "oklch(1 0 0 / 0.07)",
          "glass-glow": "oklch(1 0 0 / 0.05)",
          "glass-field-1": "oklch(0.36 0.12 262)",
          "glass-field-2": "oklch(0.33 0.08 200)",
          "glass-field-3": "oklch(0.32 0.1 300)"
        }
