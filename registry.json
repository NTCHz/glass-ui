  "homepage": "https://github.com/NTCHz/glass-ui",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Glass theme",
      "description": "Apple Liquid Glass tokens: opaque content layer + glass-clear / glass / glass-thick chrome, glass-press interaction, Inter + Sarabun type.",
      "dependencies": [
        "shadcn",
        "tw-animate-css",
        "@fontsource-variable/inter",
        "@fontsource/sarabun"
      ],
      "cssVars": {
        "theme": {
          "font-sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Inter Variable\", \"Sarabun\", system-ui, sans-serif",
          "font-heading": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Inter Variable\", \"Sarabun\", system-ui, sans-serif"
        },
        "light": {
          "background": "oklch(0.975 0.004 250)",
          "foreground": "oklch(0.21 0.015 260)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.21 0.015 260)",
          "popover": "oklch(0.99 0.002 250)",
          "popover-foreground": "oklch(0.21 0.015 260)",
          "primary": "oklch(0.53 0.21 262)",
          "primary-foreground": "oklch(1 0 0)",
          "secondary": "oklch(0.21 0.015 260 / 0.055)",
          "secondary-foreground": "oklch(0.21 0.015 260)",
          "muted": "oklch(0.21 0.015 260 / 0.04)",
          "muted-foreground": "oklch(0.47 0.015 260)",
          "accent": "oklch(0.53 0.21 262 / 0.1)",
          "accent-foreground": "oklch(0.45 0.2 262)",
          "destructive": "oklch(0.58 0.22 25)",
          "success": "oklch(0.68 0.17 150)",
          "success-text": "oklch(0.5 0.14 150)",
          "warning": "oklch(0.78 0.16 70)",
          "warning-text": "oklch(0.52 0.13 65)",
          "border": "oklch(0.21 0.015 260 / 0.09)",
          "input": "oklch(0.21 0.015 260 / 0.12)",
          "ring": "oklch(0.53 0.21 262 / 0.5)",
          "chart-1": "oklch(0.6 0.2 262)",
          "chart-2": "oklch(0.72 0.13 195)",
          "chart-3": "oklch(0.6 0.2 300)",
          "chart-4": "oklch(0.75 0.16 60)",
          "chart-5": "oklch(0.66 0.2 350)",
          "radius": "0.75rem",
          "glass-solid": "oklch(0.985 0.003 250)",
          "glass-clear": "oklch(1 0 0 / 0.2)",
          "glass-regular": "oklch(1 0 0 / 0.55)",
          "glass-thick": "oklch(0.99 0.002 250 / 0.8)",
          "glass-sheen": "oklch(1 0 0 / 0.6)",
          "glass-rim-hi": "oklch(1 0 0 / 0.95)",
          "glass-rim-lo": "oklch(1 0 0 / 0.35)",
          "glass-edge": "oklch(0.2 0.02 260 / 0.08)",
          "glass-glow": "oklch(1 0 0 / 0.35)",
          "glass-field-1": "oklch(0.85 0.09 255)",
          "glass-field-2": "oklch(0.9 0.07 200)",
          "glass-field-3": "oklch(0.88 0.07 300)"
        },
        "dark": {
          "background": "oklch(0.17 0.01 260)",
          "foreground": "oklch(0.96 0.004 260)",
          "card": "oklch(0.21 0.012 260)",
          "card-foreground": "oklch(0.96 0.004 260)",
          "popover": "oklch(0.23 0.012 260)",
          "popover-foreground": "oklch(0.96 0.004 260)",
          "primary": "oklch(0.56 0.2 260)",
          "primary-foreground": "oklch(1 0 0)",
          "secondary": "oklch(1 0 0 / 0.08)",
          "secondary-foreground": "oklch(0.96 0.004 260)",
          "muted": "oklch(1 0 0 / 0.05)",
          "muted-foreground": "oklch(0.7 0.015 260)",
          "accent": "oklch(0.56 0.2 260 / 0.22)",
          "accent-foreground": "oklch(0.78 0.13 258)",
          "destructive": "oklch(0.68 0.19 22)",
          "success": "oklch(0.72 0.17 150)",
          "success-text": "oklch(0.78 0.17 150)",
          "warning": "oklch(0.8 0.15 75)",
          "warning-text": "oklch(0.82 0.15 75)",
          "border": "oklch(1 0 0 / 0.08)",
          "input": "oklch(1 0 0 / 0.12)",
          "ring": "oklch(0.68 0.16 258 / 0.6)",
          "chart-1": "oklch(0.68 0.17 260)",
